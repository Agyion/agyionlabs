# Mock is a local simulation. Soroban writes require an exact reviewed V3 release.
# Public release pins: ../deployments/public-testnet.json. Preserve its active
# CBII deployment for existing public records; do not select the renamed test copy.
# Mode must be exactly mock or soroban; unset defaults to mock, other values fail.
NEXT_PUBLIC_AGYION_MODE=mock
NEXT_PUBLIC_AGYION_CONTRACT_ID=
# Required in soroban mode: lowercase SHA-256 of the reviewed deployed kernel.
# Leave blank for mock mode; a missing or invalid pin disables public-app writes.
NEXT_PUBLIC_AGYION_WASM_HASH=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_ANCHOR_URL=https://tr-mock-anchor.fly.dev
# Optional HTTPS TOML signing-key pin; public G... address, never a secret.
NEXT_PUBLIC_ANCHOR_SIGNING_KEY=
# Reserved. The app currently offers only Freighter, whose active network can
# be verified. A project ID does not enable the unsupported WalletConnect adapter.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
